{
  "name": "pos-frontend",
  "version": "1.0.0",
  "description": "Frontend del Punto de Venta (Tailwind CSS + POS design system)",
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind.css -o ./dist/css/app.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind.css -o ./dist/css/app.css --watch",
    "prebuild": "npm run build:css",
    "dev": "npm run watch:css",
    "start": "npx serve ."
  },
  "keywords": [
    "punto-de-venta",
    "tailwind",
    "pos"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1"
  }
}

