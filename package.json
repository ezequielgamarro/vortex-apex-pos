{
  "name": "pos-escritorio",
  "version": "1.4.0",
  "description": "Electron shell para el Punto de Venta (frontend web + backend FastAPI empaquetado como pos-backend.exe).",
  "main": "electron/main.js",
  "author": "Vortex Apex",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:css": "npm --prefix frontend run build:css",
    "build:backend": "app\\.venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean pos-backend.spec",
    "build:full": "npm run build:css && npm run build:backend",
    "build:installer": "npm run build:full && electron-builder --win",
    "dist": "npm run build:installer",
    "dist:firmado": "node tools_build/exigir_firma.js && npm run build:installer",
    "dist:dir": "npm run build:full && electron-builder --win --dir",
    "pack": "npm run build:full && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.vortex.apex.pos",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },

    "productName": "Punto de Venta",
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/pos-backend.exe",
        "to": "pos-backend.exe"
      }
    ],
                "win": {
          "icon": "build/icon.ico",
          "target": [
            {
              "target": "nsis",
              "arch": ["x64"]
            }
          ]
        },
                "nsis": {
          "artifactName": "Punto de Venta Setup ${version}.${ext}",
          "oneClick": false,
          "allowToChangeInstallationDirectory": true,
          "createDesktopShortcut": true,
          "createStartMenuShortcut": true,
          "shortcutName": "Punto de Venta",
          "installerIcon": "build/icon.ico",
          "uninstallerIcon": "build/icon.ico"
        }
  }
}
