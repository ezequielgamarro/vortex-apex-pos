# Environment files
.env

# ============================================================================
# LLAVES DE LICENCIAS (CRÍTICO: NUNCA subir al repositorio)
# ----------------------------------------------------------------------------
# La llave privada permite EMITIR licencias válidas. Si se filtra, cualquiera
# puede generar activaciones. Si perdés esta llave, perdés la capacidad de
# firmar. Hacé BACKUP en un medio seguro (gestor de contraseñas / USB cifrado),
# NUNCA en Git ni en la nube pública.
# ============================================================================
*.key
*.pem
tools_licencia/*.key
# La llave PÚBLICA de licencias no es secreta y el build la necesita: se versiona.
# (La privada, tools_licencia/vortex_private.key, y secret.key siguen ignoradas.)
!app/licencia_public.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/

# Electron / empaquetado de escritorio
node_modules/
release/
dist/pos-backend.exe

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.coverage.*
*.cover

# Logs
*.log
logs/

# Bases de datos locales (se generan en tiempo de ejecución / reset)
# Incluye sus copias de respaldo (.bak_preseed, .bak, etc.): contienen usuarios
# y hashes de contraseña, NUNCA deben subirse a un repositorio.
pos_local.db
pos_local.db.*
*.db
*.bak
*.bak_*
*.sqlite
*.sqlite3
*.backup.sqlite
*_backup.sqlite

# Minio / Supabase local artifacts
docker-data/

# Docker
*.pid

